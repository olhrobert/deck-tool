# Copy to .env.local and fill in. .env* is gitignored.

# logo.dev — company logos by domain. Optional: without these, the brand
# screens work and the "Pull from logo.dev" control explains what is missing.
# Keys: https://www.logo.dev — the free tier covers this use.

# Publishable key (pk_…). Used to build img.logo.dev URLs, which are sent to
# the browser. Designed to be public.
LOGO_DEV_PUBLISHABLE_KEY=

# Secret key (sk_…). Used for the name-to-domain search API, server-side only.
# Never sent to the browser. Without it, you enter the domain yourself.
LOGO_DEV_SECRET_KEY=
