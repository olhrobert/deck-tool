{
	"components": [
		{
			"id": "slide-title",
			"tag": "slide-title-group",
			"template": "slide-title/slide-title-group-md.html",
			"slots": [
				{ "name": "pre", "tag": "slide-pretitle", "required": false },
				{ "name": "main", "tag": "slide-title", "required": true },
				{ "name": "sub", "tag": "slide-subtitle", "required": false }
			]
		},
		{
			"id": "card",
			"tag": "card",
			"template": "card/card.html",
			"slots": [
				{
					"name": "pretitle",
					"tag": "card-pretitle",
					"required": true
				},
				{
					"name": "title",
					"tag": "card-title",
					"required": true
				},
				{
					"name": "text",
					"tag": "body-copy",
					"required": false
				},
				{
					"name": "meta",
					"tag": "card-meta",
					"required": false
				}
			]
		},
		{
			"id": "callout",
			"tag": "callout",
			"template": "callout/callout.html",
			"slots": [
				{
					"name": "title",
					"tag": "callout-title",
					"required": true
				},
				{
					"name": "description",
					"tag": "callout-description",
					"required": false
				}
			]
		},
		{
			"id": "badge",
			"tag": "badge",
			"template": "badge/badge.html",
			"slots": [
				{
					"name": "label",
					"tag": "badge-text",
					"required": true
				}
			]
		},
		{
			"id": "slide-footer",
			"tag": "slide-footer",
			"template": "slide-footer/slide-footer.html",
			"slots": [
				{ "name": "logo", "tag": "img", "required": false },
				{ "name": "notes", "tag": "slide-footer-notes", "required": false },
				{
					"name": "deck-title",
					"tag": "slide-footer-title",
					"required": false
				},
				{
					"name": "chapter",
					"tag": "slide-footer-chapter",
					"required": false
				},
				{ "name": "page", "tag": "slide-footer-page", "required": true }
			]
		},
		{
			"id": "attribution-box-title",
			"tag": "attribution-box",
			"match": { "attrs": { "variant": "title" } },
			"template": "attribution-box/attribution-box.html",
			"infer": "attribution-title",
			"slots": [
				{ "name": "credit", "tag": "text", "required": true },
				{ "name": "logo", "tag": "img", "required": true }
			]
		}
	]
}
